#!/bin/bash
## YES=1 skips first question
## YES=2 forces rmr at the end
## test=1 tests 24-bit flac
## test=2 tests 16-bit flac

export TERM
red="$(tput setaf 9)"
bold="$(tput bold)"
boldred="$(tput setaf 9 bold)"
tput0="$(tput sgr0)"

editscript(){
  local scriptpath script path swp; scriptpath=$(realpath "$0" 2>/dev/null); script="${scriptpath##*/}"; path="${scriptpath%/*}"; swp="$path/.$script.swp"
     [[ ! -e "$swp" ]] && printf "\n\n%s\n\n" "$swp" && (/usr/bin/nano "$scriptpath") && exit
     printf "\n%s is already being edited.\n%s exists; try fg or look in another window.\n" "$scriptpath" "$swp"; exit ;}

pause(){ read -rp "$*" < /dev/tty; }

yn(){
  local yn
  while true; do
    printf '%s (y/n) ' "$1"
    read -r yn </dev/tty
      case $yn in
        [yY] ) return 0 ;;  # Success (true)
        [nN] ) return 1 ;;  # Failure (false)
           * ) echo "Please answer y or n." ;;
      esac
  done
}

help(){
  cat <<'EOF'
Usage: downcode [OPTIONS]

Options:
  --edit       Open downcode in the script editor and exit.

  -y, --yes    Skip the initial confirmation before reducing the sample rate.
               Retain the final confirmation before removing 24-bit backups.

  -Y, --YES    Skip both confirmations:
               - Initial confirmation before reducing the sample rate.
               - Final confirmation before removing 24-bit backups
                 (rmr --force).

  -t, --test   Test the original 24-bit FLAC files before downcoding
               (flac -wt, with ffmpeg fallback).

  -T, --TEST   Test both the original 24-bit and resulting 16-bit FLAC files.

  -h, --help   Display this help and exit.
EOF
}

while (( "$#" )); do
  [[ "$1" =            '--edit' ]] && { editscript;    shift; exit "$?"; }
  [[ "$1" =            '--help' ]] && { help;          shift; exit "$?"; }
  [[ "$1" =         @(-y|--yes) ]] && { YES=1;         shift; continue; }
  [[ "$1" =         @(-Y|--YES) ]] && { YES=2;         shift; continue; }
  [[ "$1" =        @(-t|--test) ]] && { test=1;        shift; continue; }
  [[ "$1" =        @(-T|--TEST) ]] && { test=2;        shift; continue; }
  [[ "$1" =            @(|-)-TY ]] && { test=2; YES=2; shift; continue; }
  printf 'Passed option `%s` unrecognized; removing and continuing.\n' "$1"
  shift
done

if (( YES > 1 )); then
  printf 'Option `-Y|--YES` selected; both the initial confirmation of reducing sample rate and final removal of 24-bit backups will be skipped (rmr --force)\n'
elif (( YES )); then
  printf 'Option `-y|--yes` selected; the initial confirmation of reducing sample rate will be skipped.\n'
fi

if (( test > 1 )); then
  printf 'Option `-T|--TEST` selected; both the starting 24-bit and the downcoded 16-bit flacs will be checked.\n'
elif (( test )); then
  printf 'Option `-t|--test` selected; the starting 24-bit flacs will be checked (flac -wt with ffmpeg fallback).\n'
fi

if command -v mediainfo &> /dev/null; then
  mi=1
elif ! command -v ffprobe &> /dev/null; then
  echo "mediainfo and ffprobe could not be found. Please install one to continue."
  exit 1
fi

# check for flacs first
printf '\nCurrent directory is:\n %s%s%s\n\n' "$boldred" "$(pwd)" "$tput0"
printf 'Checking for flacs and permissions...\n\n'
flacs=(*flac)
[[ "$flacs" = '*flac' ]] && { printf '\n[%sERROR%s] %sNo flacs in the present working directory!%s\nPlease check and try again.\n(exit 1)\n' "$boldred" "$tput0" "$bold" "$tput0"; exit 1; }

# check if pwd is sshfs mount
findmnt -T . | grep -q "fuse.sshfs" && unset SUDO && fuse=true
if "${fuse:=false}"; then
  printf '%sOn an sshfsmount!%s\n\n' "$boldred" "$tput0"
  touchout="$(touch boobs 2>&1)"; fusetouch="$?"
  ! (( fusetouch )) && rm boobs
else
  (( verbose )) && printf 'Not on an sshfsmount.\n\n'
fi

# check for directory permissions
#pause "$fusetouch $fuse $PWD"
(( fusetouch )) || [[ "$fuse" != true && ! -w "$PWD" ]] &&
  if yn "$(printf '\nThe pwd %s is not writable.\nWould you like to "own" this directory?' "$(pwd)")"; then
    ownout=( "$(own 2>&1|tee /dev/tty; echo "$?")" )
    ec="${ownout[-1]}"
    unset 'ownout[-1]'
    if (( ec )); then
      printf '\n[%sERROR%s] own returned an error:\n'  "$boldred" "$tput0"
      printf '%s\n' "${ownout[@]}"
      printf '\nFix permissions!\n(exit %s)\n\n' "$ec"
      exit "$ec"
    else
      printf %s\\n "${ownout[@]}"
    fi
  else
    printf '\n[%sERROR%s] Fix permissions!\n(exit 1)\n\n' "$boldred" "$tput0"
    exit 1
  fi

# check for write permission of flacs
for i in "${flacs[@]}"; do
  [[ ! -w "$i" ]] &&
    if yn "$(printf '\nThe file %s is not writable.\nWould you like to "own" this directory?' "$i")"; then
      ownout=( "$(own 2>&1; ec="$?")" )
      if ((ec)); then
        printf '\n[%sERROR%s] own returned an error:\n'  "$boldred" "$tput0"
        printf '%s\n' "${ownout[@]}"
        printf '\nFix permissions!\n(exit 1)\n'
        exit 1
      else
        printf %s\\n "${ownout[@]}"
      fi
    else
      printf '\n[%sERROR%s] Fix permissions!\n(exit 1)\n'  "$boldred" "$tput0"
      exit 1
    fi
done

hr(){
    printf -- '%*s\n' "${1:-$COLUMNS}" | tr ' ' "${2:-#}"
}


for i in *flac; do
  if (( mi )); then
    readarray -t bitsHz < <(mediainfo --Output="Audio;%BitDepth%\n%SamplingRate%" "$i")

 else
    readarray -t bitsHz < <(ffprobe \
                              -v error \
                              -select_streams a:0 \
                              -show_entries stream=bits_per_raw_sample \
                              -show_entries stream=sample_rate \
                              -of default=noprint_wrappers=1:nokey=1 \
                              file:"$i")
  fi

  bits="${bitsHz[0]}"
  Hz="${bitsHz[1]}"
  kHz=$(( Hz / 1000 ))
  kHzr=$(( Hz % 1000 ))
  kHzr="${kHzr%%0*}"
  kHzfloat="$kHz"
  (( kHzr )) && kHzfloat="$kHz.$kHzr"

## Wed Nov 18 10:21:47 AM EST 2026
## why was this change made?
# if (( bits <= 16 )) || (( Hz < 48000 )); then
#  if (( bits <= 16 )) || (( Hz < 44100 )); then
  if (( bits <= 16 )) && (( Hz == 44100 || Hz == 48000 )); then
  # over=true
  # (( Hz == 48000 )) && yn "File is $bits/$Hz, continue with processing?" && over=false
  # if "$over"; then
      printf '%s%sThe file, %s%s%s%s, %s%sdoes not appear to be above 16/48 bits/kHz:%s\n Bit rate   : %s bits\n Sample rate: %s kHz\n%s%sPlease investigate. (exit 1)\n\n%s' \
       "$bold" \
       "$red" \
       "$tput0" \
       "$bold" \
       "$i" \
       "$tput0" \
       "$bold" \
       "$red" \
       "$tput0" \
       "$bits" \
       "${kHzfloat}" \
       "$bold" \
       "$red" \
       "$tput0"
      (( files16bits++ ))
  # fi
  elif (( bits <= 16 )) && (( Hz > 48000 )); then
    printf '%s%s[ERROR] The file, %s%s%s%s, %s%s is 16 bits but over 48 kHz:%s\n Bit rate   : %s bits\n Sample rate: %s kHz\n%s%sPlease investigate. (exit 1)\n\n%s' \
      "$bold" \
      "$red" \
      "$tput0" \
      "$bold" \
      "$i" \
      "$tput0" \
      "$bold" \
      "$red" \
      "$tput0" \
      "$bits" \
      "${kHzfloat}" \
      "$bold" \
      "$red" \
      "$tput0"
    printf '        This configuration is not supposed to turn up in the wild! Additional coding will need to be done to address!\n'
    exit 1
  else
    (( files24bits++ ))
  fi

  if (( files16bits )) && (( files24bits )); then
    printf '[ERROR] A mix of %s 24-bit and %s 16-bit flacs found in %s. Investigate. (exit 1)\n'
    exit 1
  elif (( files16bits )); then
    printf '[ERROR] Only %s 16-bit flacs found in %s. Investigate. (exit 1)\n'
    exit 1
  elif !(( files24bits )); then
    printf '[ERROR] No flacs over 16-bit were found in %s. Investigate. (exit 1)\n'
    exit 1
  fi


  if (( test )); then
    hr
    printf ' — Testing flac file —\n'
    printf ' — Testing with flac -wt — \n'
    if ! flac -tw "$i" 2> >(grep -vE '^(flac [0-9]|Copyright \(C\)|flac comes with|welcome to redistribute|certain conditions|^$|Type `flac)'); then
      printf ' — ffmpeg decode — \n'
      if ffmpeg -nostdin -v error -stats -i "$i" -f null -; then
        printf '\n\n[WARN] ⚠️ File `%s` \n       failed `flac -t` but passed ffmpeg decode.\n\n' "$i"
      else
        ## turn of final removal on error
        YES=0
        printf '[ERROR] ⛔ File `%s` failed `flac -t` and ffmpeg decode.' "$i"
        if ! yn "Continue with downcode? "; then
          printf '(exit 130)\n'
          exit 130
        fi
      fi
    fi
    printf 'Done testing %s\n' "$i"
    hr
  fi


  ## This change will let the script pick a multiple of 44.1 or 48 kHz
  ## instead of forcing everything to 48 kHz regardless.
  # Check if the rate isn't already a base consumer standard
  if (( Hz != 48000 )) && (( Hz != 44100 )); then
    printf 'The sample rate is %s Hz.\n' "$Hz"
    # Fallback for multiples of 44.1 kHz and non-standard rates (e.g. old 32kHz or weird audio)
    targetHz=44100

    # Dynamically determine the target based on mathematical family
    if (( Hz % 48000 == 0 )); then
      targetHz=48000
      printf 'The file sample rate is a multiple of 48 kHz...\n'
    elif (( Hz % 44100 == 0 )); then
      printf 'The file sample rate is a multiple of 44.1 kHz...\n'
    else
      printf '%s[%swarn%s%s]%s The file sample rate (%s) is %sNOT%s a multiple of 48 or 44.1 kHz!\n' \
        "$bold" "$red" "$tput0" "$bold" "$tput0" "$Hz" "$boldred" "$tput0"
      printf 'Will use %s as the fallback sample rate if you choose to proceed.\n' "$targetHz"
    fi

    if (( Hz > targetHz )) && ! "${changerate:=false}" ; then
      printf \\n
      if (( YES )) || yn "Do you want to set the sample rate to $targetHz Hz?"; then
        Hz="$targetHz"
        changerate=true # Set the flag so the rest of the loop skips prompting
      else
        printf '\nUser aborted. (exit 130)%s\n\n' "$tput0"
        exit 130
      fi
    elif (( Hz > targetHz )) && "${changerate:=false}"; then
      Hz="$targetHz"
    fi
  fi

  if [[ "$i" = *.24.flac ]]; then
    flac24="$i"
    flac16="${flac24/.24.flac/.flac}"
  else
    flac16="$i"
    flac24="${i/.flac/.24.flac}"
    mv "$i" "$flac24"
  fi

  ffmpeg -n \
    -v error \
    -stats \
    -hide_banner \
    -nostdin \
    -i file:"$flac24" \
    -af aresample=osf=s16:dither_method=triangular_hp \
    -ar "$Hz" \
    file:"$flac16"

    ecffmpeg="$?"
    if (( ecffmpeg )); then
      (( YES )) && printf '\n\n[WARN] ⚠️  Automatic removal of 24-bit flacs disabled!\n\n'
      printf '\n\n[WARN] ⚠️  File `%s` \n       ffmpeg resample/downcode reported an error.\n' "$flac16"
      YES=0
    fi

  if (( test == 2 )); then
    hr
    printf ' — Testing downcoded flac file —\n'
    printf ' — Testing with flac -wt — \n'
    if ! flac -tw "$flac16" 2> >(grep -vE '^(flac [0-9]|Copyright \(C\)|flac comes with|welcome to redistribute|certain conditions|^$|Type `flac)'); then
      ## turn off automatic final rmr:
      (( YES )) && printf '\n[WARN] Automatic removal of 24-bit flacs disabled!\n\n'
      YES=0
      printf ' — ffmpeg decode — \n'
      if ffmpeg -nostdin -v error -stats -i "$i" -f null -; then
        printf '\n\n[WARN] ⚠️ File `%s` \n       failed `flac -t` but passed ffmpeg decode.\n' "$flac16"
      else
        printf '[ERROR] ⛔ File `%s` failed `flac -t` and ffmpeg decode.' "$flac16"
        if ! yn "Continue with downcode? "; then
          printf '(exit 130)\n'
          exit 130
        fi
      fi
    fi
    printf 'Done testing %s\n' "$i"
    hr
  fi
done

mkdir "24-bit"
mv *.24.flac "24-bit"
flac16s=( *.flac )
flac24s=( ./24-bit/*.24.flac )
flac16d=$(mediaduration "${flac16s[@]}")
flac24d=$(mediaduration "${flac24s[@]}")
flac24n=( "${flac24s[@]#./24-bit\/}" )
flac24n=( "${flac24n[@]//.24}" )

if [[ "${flac16s[*]}" != "${flac24n[*]}" ]]; then
  printf '\n[WARN] ---- ⚠️ File arrays DO NOT MATCH! ----\n\n'
  printf '%s\n%s\n' "${flac16s[*]}" "${flacs24[*]}"
  (( YES )) && printf '[WARN] Automatic removal of 24-bit flacs disabled!\n\n'
  YES=0
else
  printf '\n\nFile arrays match...\n'
fi

if [[ "$flac16d" != "$flac24d" ]]; then
  printf '\n[WARN] ---- ⚠️ FLAC times DO NOT MATCH! ----\n'
  printf '%s != %s\n\n' "$flac16d" "$flac24d"
  (( YES )) && printf '[WARN] Automatic removal of 24-bit flacs disabled!\n\n'
  YES=0
else
  printf 'Durations match... %s\n' "$flac16d"
fi

(( YES == 2 )) && rmrarr=( '--force' )
rmrarr+=( './24-bit' )
rmr "${rmrarr[@]}" </dev/tty

ec="$?"
(( ecffmpeg )) && ec="$?"
printf 'exit %s\n' "$ec"
exit "$ec"

